		{
			"name": "postfix",
			"aptPackages": ["postfix", "sasl2-bin", "libsasl2-modules", "postfix-pcre", "opendkim", "opendkim-tools"],
			"backup": [
				{
					"name": "etc-postfix",
					"type": "DIR",
					"path": "/etc/postfix/"
				},
				{
					"name": "opendkim",
					"type": "DIR",
					"path": "/etc/opendkim/"
				},
				{
					"name": "sasl-db",
					"type": "FILE",
					"path": "/etc/sasldb2"
				},
				{
					"name": "opendkim-conf",
					"type": "FILE",
					"path": "/etc/opendkim.conf"
				}

			],
			"preRestore": [
				{
					"name": "Temporary stop service before copying configs",
					"command": "systemctl stop postfix opendkim"
				}
			],
			"postRestore": [
				{
					"name": "Restore Permissions",
					"command": "chown postfix:postfix /etc/sasldb2; chmod 660 /etc/sasldb2; sudo gpasswd -a postfix opendkim; sudo chown -R opendkim:opendkim /etc/opendkim"
				},
				{
					"name": "Sync SASL to Jail",
					"command": "mkdir -p /var/spool/postfix/etc; cp /etc/sasldb2 /var/spool/postfix/etc/sasldb2; chown postfix:postfix /var/spool/postfix/etc/sasldb2; chmod 660 /var/spool/postfix/etc/sasldb2"
				},
				{
					"name": "Regenerate databases",
					"command": "postmap /etc/postfix/virtual; sudo newaliases"
				},
				{
					"name": "Restore Service",
					"command": "systemctl daemon-reload; systemctl start postfix opendkim; systemctl enable --now postfix opendkim"
				}
			]
		}
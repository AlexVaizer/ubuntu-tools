		{
			"name": "nginx",
			"packages": ["nginx"],
			"backup": [
				{
					"name": "nginx-configs",
					"type": "DIR",
					"path": "/etc/nginx/"
				}
			],
			"preRestore": [],
			"postRestore": [
				{
					"name": "Remove default site",
					"command":"rm -f /etc/nginx/sites-enabled/default; rm -f /etc/nginx/sites-available/default"
				},
				{
					"name": "Enable nginx",
					"command":"systemctl enable --now nginx.service; systemctl restart nginx.service"
				}
			]
		}